{
  "family": "n5453313-fractal-scaler",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::901444280953:role/Execution-Role-CAB432-ECS",
  "taskRoleArn": "arn:aws:iam::901444280953:role/Task-Role-CAB432-ECS",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "tags": [
    {
      "key": "qut-username",
      "value": "n5453313@qut.edu.au"
    },
    {
      "key": "purpose",
      "value": "assessment 3"
    }
  ],
  "containerDefinitions": [
    {
      "name": "scaler",
      "image": "901444280953.dkr.ecr.ap-southeast-2.amazonaws.com/n5453313-fractal-scaler:latest",
      "essential": true,
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "ap-southeast-2"
        },
        {
          "name": "PLATFORM",
          "value": "aws"
        },
        {
          "name": "TILE_BUCKET",
          "value": "n5453313-fractal-tiles"
        },
        {
          "name": "QUEUE_URL",
          "value": "https://sqs.ap-southeast-2.amazonaws.com/901444280953/n5453313-a3-render-queue"
        },
        {
          "name": "DLQ_URL",
          "value": "https://sqs.ap-southeast-2.amazonaws.com/901444280953/n5453313-a3-render-dlq"
        },
        {
          "name": "ECS_CLUSTER",
          "value": "n5453313-a2-cluster"
        },
        {
          "name": "WORKER_SERVICE",
          "value": "n5453313-fractal-worker"
        },
        {
          "name": "MIN_WORKERS",
          "value": "0"
        },
        {
          "name": "MAX_WORKERS",
          "value": "8"
        },
        {
          "name": "TARGET_BACKLOG_PER_WORKER",
          "value": "4"
        },
        {
          "name": "SCALE_IN_COOLDOWN_MS",
          "value": "60000"
        },
        {
          "name": "SCALER_INTERVAL_MS",
          "value": "10000"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/n5453313-fractal-scaler",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "scaler"
        }
      }
    }
  ]
}
